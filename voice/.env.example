# Worker configuration. Non-secret values are `vars` in wrangler.jsonc;
# secrets go in with `wrangler secret put NAME` (see README › Deploy).
# For `wrangler dev`, copy this file to .dev.vars.

# ─── Twilio ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX              # the inbound line pointed at POST /twiml
TWILIO_VALIDATE_RELAY_SIGNATURE=false   # true = 403 an unsigned relay handshake; false = log only (see README › Cutover)

# ─── LLM ──────────────────────────────────────────────────────────────────
# Which vendor answers the call is configured at /admin/settings/ai on the
# site (Anthropic and/or OpenAI keys, primary + fallback). Those keys are
# stored encrypted; this service needs the same key to read them:
AI_KEYS_ENCRYPTION_KEY=                 # 64 hex chars, identical to the site's value
# Fallback only, used when nothing is routed in the admin:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5         # model for the env fallback
LLM_MAX_TOKENS=600

# ─── Database ─────────────────────────────────────────────────────────────
# Deployed, Postgres is reached through the HYPERDRIVE binding in
# wrangler.jsonc (no secret needed). For `wrangler dev` and `pnpm test`,
# point the binding at a local Postgres with the voice_* and ai_* tables:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:5432/jetnine

# ─── Escalation ───────────────────────────────────────────────────────────
ESCALATION_PHONE=+1XXXXXXXXXX           # on-call broker, warm transfer target
ALERT_PHONE=+1XXXXXXXXXX                # receives the SMS lead summaries
SMS_ALERTS_ENABLED=false                # flip on once A2P/toll-free registration clears
ESCALATION_DIAL_TIMEOUT=25              # seconds to ring the broker before fallback

# ─── Server ───────────────────────────────────────────────────────────────
PUBLIC_HOST=voice.jetnine.com           # host only, no scheme; used for wss:// and callback URLs
NODE_ENV=development                    # production (wrangler.jsonc) enforces Twilio signatures
LOG_RELAY_MESSAGES=true                 # dev: log every raw ConversationRelay message

# ─── Voice pipeline (ConversationRelay attributes) ───────────────────────
TTS_PROVIDER=ElevenLabs
TTS_VOICE=                              # ElevenLabs voice ID from the ConversationRelay catalog.
                                        # Empty = Twilio's en-US default (UgBBYS2sOqTuMpoF3BR0).
                                        # Candidates to audition (confirm each exists in Twilio's picker):
                                        #   nPczCjzI2devNBz1zQrb  deep, calm American male
                                        #   JBFqnCBsd6RMkjVDRZzb  warm British male, concierge register
                                        #   XrExE9yKIg1WjnnlVkGX  warm, precise female
                                        # Tune with "-speed_stability_similarity", e.g. "XrExE9yKIg1WjnnlVkGX-1.0_0.6_0.8"
TTS_MODEL=flash_v2_5
STT_PROVIDER=Deepgram
STT_MODEL=nova-3-general
RECORDING_ENABLED=true                  # if true the greeting discloses recording (two-party consent states)
