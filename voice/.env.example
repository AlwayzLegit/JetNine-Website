# ─── Twilio ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX              # the inbound line pointed at POST /twiml

# ─── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5         # any current Sonnet-class model or newer

# ─── Supabase (service role, server-side only) ────────────────────────────
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Escalation ───────────────────────────────────────────────────────────
ESCALATION_PHONE=+1XXXXXXXXXX           # on-call broker, warm transfer target
ALERT_PHONE=+1XXXXXXXXXX                # receives the SMS lead summaries
SMS_ALERTS_ENABLED=false                # flip on once A2P/toll-free registration clears
ESCALATION_DIAL_TIMEOUT=25              # seconds to ring the broker before fallback

# ─── Server ───────────────────────────────────────────────────────────────
PUBLIC_HOST=your-service.onrender.com   # host only, no scheme; used for wss:// and callback URLs
PORT=3000
NODE_ENV=development
LOG_RELAY_MESSAGES=true                 # dev: log every raw ConversationRelay message

# ─── Voice pipeline (ConversationRelay attributes) ───────────────────────
TTS_PROVIDER=ElevenLabs
TTS_VOICE=                              # ElevenLabs voice ID from the ConversationRelay catalog,
                                        # optionally "-speed_stability_similarity", e.g. "XrExE9yKIg1WjnnlVkGX-1.0_0.6_0.8"
TTS_MODEL=flash_v2_5
STT_PROVIDER=Deepgram
STT_MODEL=nova-3
RECORDING_ENABLED=true                  # if true the greeting discloses recording (two-party consent states)
